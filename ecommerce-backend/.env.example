# Copy these payment settings into the backend container environment or an ignored .env file.
# Use test credentials first. Do not commit real keys.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_LIVE_MODE=false
PAYMONGO_PAYMENT_METHODS=gcash,card
PAYMONGO_SUCCESS_URL=http://localhost:4200/account?payment=success
PAYMONGO_CANCEL_URL=http://localhost:4200/account?payment=cancelled
PAYMONGO_SIGNATURE_TOLERANCE_SECONDS=300
